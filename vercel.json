{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 build/pull_cms.py && python3 build/build.py && python3 build/package.py",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cms/daily",
      "schedule": "5 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(id|my)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/aboutm2d",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contactus",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sitemap",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/menu",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hotelathome",
      "destination": "/projects/hotel-at-home",
      "permanent": true
    },
    {
      "source": "/japandispirit",
      "destination": "/projects/japandi-spirit",
      "permanent": true
    },
    {
      "source": "/embraceserenity",
      "destination": "/projects/embrace-serenity",
      "permanent": true
    },
    {
      "source": "/hozon",
      "destination": "/projects/hozon",
      "permanent": true
    },
    {
      "source": "/ubbanfusion",
      "destination": "/projects/urban-fusion",
      "permanent": true
    },
    {
      "source": "/ubbanfusion-1",
      "destination": "/projects/chaseki",
      "permanent": true
    },
    {
      "source": "/projects/japandispirit",
      "destination": "/projects/japandi-spirit",
      "permanent": true
    },
    {
      "source": "/projects/the-hozon",
      "destination": "/projects/hozon",
      "permanent": true
    },
    {
      "source": "/projects/urban-grain",
      "destination": "/projects/urban-fusion",
      "permanent": true
    },
    {
      "source": "/projects/victorian-revival",
      "destination": "/projects/rattan",
      "permanent": true
    },
    {
      "source": "/projects/:slug(solis.*)",
      "destination": "/projects/oak-and-ember",
      "permanent": true
    },
    {
      "source": "/projects/:slug((?!(?:chaseki|embrace\\-serenity|fu|hotel\\-at\\-home|hozon|japandi\\-spirit|nimbus|oak\\-and\\-ember|rattan|sonata|urban\\-fusion)(?:$|/))[^./]+)",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/post/:slug(5\\-room\\-bto\\-interior\\-design\\-ideas\\-that\\-balance\\-space\\-style\\-and\\-function|5\\-zoning\\-tips\\-for\\-narrow\\-terrace\\-house\\-designs|60\\-30\\-10\\-rule\\-explained\\-why\\-it\\-works\\-and\\-how\\-it\\-can\\-transform\\-any\\-room|bedroom\\-interior\\-design\\-for\\-couples\\-style\\-storage\\-compromise|blending\\-wabi\\-sabi\\-and\\-japandi\\-interiors\\-can\\-you\\-have\\-the\\-best\\-of\\-both\\-worlds|colour\\-palettes\\-for\\-scandinavian\\-hdb\\-interior\\-designs\\-from\\-cool\\-whites\\-to\\-earthy\\-tones|form\\-function\\-and\\-flow\\-comparing\\-japandi\\-and\\-scandinavian\\-design|hdb\\-lighting\\-guide\\-how\\-to\\-light\\-every\\-room\\-in\\-your\\-flat\\-efficiently|how\\-to\\-create\\-a\\-cosy\\-living\\-room\\-without\\-sacrificing\\-style|how\\-to\\-fit\\-a\\-walk\\-in\\-wardrobe\\-into\\-your\\-hdb\\-master\\-bedroom|interior\\-design\\-for\\-small\\-spaces\\-how\\-to\\-make\\-a\\-small\\-room\\-look\\-bigger|key\\-differences\\-between\\-minimalist\\-and\\-industrial\\-interior\\-designs|minimalist\\-interior\\-design\\-in\\-singapore\\-ideas\\-for\\-hdbs\\-condos|natural\\-light\\-vs\\-artificial\\-light\\-when\\-to\\-use\\-which\\-in\\-home\\-design|small\\-condo\\-design\\-tips\\-furniture\\-strategies\\-storage\\-solutions\\-and\\-visual\\-flow|understanding\\-hdb\\-renovation\\-guidelines\\-stay\\-compliant\\-and\\-hassle\\-free|what\\-goes\\-into\\-a\\-4\\-room\\-hdb\\-resale\\-renovation|what\\-impacts\\-resale\\-hdb\\-value\\-most\\-location\\-layout\\-or\\-renovation|what\\-is\\-an\\-open\\-floor\\-plan\\-pros\\-and\\-cons\\-for\\-modern\\-homes|what\\-is\\-contemporary\\-interior\\-design\\-key\\-features\\-and\\-how\\-it\\-differs\\-from\\-modern\\-design)",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/post/:slug*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/categories/:c*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/page/:p*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/services/:s+",
      "destination": "/services",
      "permanent": true
    }
  ],
  "cleanUrls": true
}
